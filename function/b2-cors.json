[
    {
        "corsRuleName": "AllowUploads",
        "allowedOrigins": ["*"],
        "allowedHeaders": ["*"],
        "allowedOperations": [
            "s3_put",
            "s3_get",
            "s3_head",
            "s3_delete",
            "b2_upload_file",
            "b2_upload_part",
            "b2_download_file_by_id",
            "b2_download_file_by_name"
        ],
        "exposeHeaders": ["ETag", "x-amz-request-id"],
        "maxAgeSeconds": 3600
    }
]