# S3 Compatible Storage Configuration (e.g. Backblaze B2, Cloudflare R2)
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here

# For Backblaze B2: https://s3.us-west-000.backblazeb2.com
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your-s3-endpoint.com

# Your specific bucket name
S3_BUCKET_NAME=your_bucket_name_here

# Region is often 'us-east-1' or 'auto' for R2
S3_REGION=us-east-1

# Optional: CDN URL for returning a public link when the bucket is private
CDN_URL=https://your-cdn-domain.com

# Optional: Bunny CDN API key for automatic cache purging on upload
# Get from: https://dash.bunny.net -> API Keys
BUNNY_API_KEY=your-bunny-api-key

# Optional: Local development port (default 8080)
PORT=3000
